{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synapsegit-lp-studio.local/schemas/api-v1.schema.json",
  "title": "SynapseGit LP Studio local API v1",
  "description": "Canonical public DTO schema for the local LP Studio API.",
  "oneOf": [
    { "$ref": "#/$defs/bootstrapResponse" },
    { "$ref": "#/$defs/createProjectRequest" },
    { "$ref": "#/$defs/projectsResponse" },
    { "$ref": "#/$defs/projectResponse" },
    { "$ref": "#/$defs/createImportPreviewRequest" },
    { "$ref": "#/$defs/importPreviewResponse" },
    { "$ref": "#/$defs/confirmImportRequest" },
    { "$ref": "#/$defs/createTargetRequest" },
    { "$ref": "#/$defs/targetResponse" },
    { "$ref": "#/$defs/targetV1" },
    { "$ref": "#/$defs/targetResolverResultV1" },
    { "$ref": "#/$defs/createContextRequest" },
    { "$ref": "#/$defs/contextResponse" },
    { "$ref": "#/$defs/createProposalRequest" },
    { "$ref": "#/$defs/proposalResponse" },
    { "$ref": "#/$defs/approvalRequest" },
    { "$ref": "#/$defs/approvalResponse" },
    { "$ref": "#/$defs/decisionRequest" },
    { "$ref": "#/$defs/decisionResponse" },
    { "$ref": "#/$defs/createExportRequest" },
    { "$ref": "#/$defs/exportResponse" },
    { "$ref": "#/$defs/errorResponse" },
    { "$ref": "#/$defs/previewSelectionMessage" },
    { "$ref": "#/$defs/previewDiagnosticMessage" },
    { "$ref": "#/$defs/previewTargetMessage" },
    { "$ref": "#/$defs/previewStructureMessage" },
    { "$ref": "#/$defs/previewActionMessage" }
  ],
  "$defs": {
    "version": { "const": "1" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "previewScopeBaseOrigin": {
      "type": "string",
      "pattern": "^http://localhost:(?:[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])$"
    },
    "scopedPreviewUrl": {
      "type": "string",
      "pattern": "^http://pv-[0-9a-f]{32}\\.localhost:(?:[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])/preview/(?!.*%(?:2[fF]|5[cC]|00))(?!(?:\\.|\\.\\.)(?:/|$))[^/?#\\\\\\u0000]+/(?!(?:\\.|\\.\\.)(?:/|$))[^/?#\\\\\\u0000]+/(?:((?!(?:\\.|\\.\\.)(?:/|$))[^/?#\\\\\\u0000]+)(?:/(?!(?:\\.|\\.\\.)(?:/|$))[^/?#\\\\\\u0000]+)*)?$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:[\\\\/])(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))[^/\\u0000]+(?:/[^/\\u0000]+)*$"
    },
    "disposition": {
      "enum": ["adopted_unchanged", "rejected", "deferred"]
    },
    "projectFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "byteLength"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "byteLength": { "type": "integer", "minimum": 0 }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "displayName",
        "revisionId",
        "acceptedManifestSha256",
        "status",
        "previewUrl",
        "files"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "displayName": { "$ref": "#/$defs/nonEmptyString" },
        "revisionId": { "$ref": "#/$defs/nonEmptyString" },
        "acceptedManifestSha256": { "$ref": "#/$defs/sha256" },
        "status": { "const": "ready" },
        "previewUrl": { "$ref": "#/$defs/scopedPreviewUrl" },
        "files": {
          "type": "array",
          "items": { "$ref": "#/$defs/projectFile" }
        }
      }
    },
    "bootstrapResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "apiVersion",
        "session",
        "editorOrigin",
        "previewOrigin",
        "capabilities"
      ],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/version" },
        "apiVersion": { "const": "v1" },
        "session": {
          "type": "object",
          "additionalProperties": false,
          "required": ["token", "expiresAt"],
          "properties": {
            "token": { "$ref": "#/$defs/nonEmptyString" },
            "expiresAt": { "$ref": "#/$defs/nonEmptyString" }
          }
        },
        "editorOrigin": { "$ref": "#/$defs/nonEmptyString" },
        "previewOrigin": { "$ref": "#/$defs/previewScopeBaseOrigin" },
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "targetKinds",
            "dispositions",
            "singleProposalPerProject",
            "importAvailable",
            "limits"
          ],
          "properties": {
            "targetKinds": {
              "type": "array",
              "prefixItems": [
                { "const": "page" },
                { "const": "block" },
                { "const": "element" },
                { "const": "text" },
                { "const": "point" },
                { "const": "region" }
              ],
              "items": false,
              "minItems": 6
            },
            "dispositions": {
              "type": "array",
              "items": { "$ref": "#/$defs/disposition" },
              "minItems": 1,
              "uniqueItems": true
            },
            "singleProposalPerProject": { "const": true },
            "importAvailable": { "type": "boolean" },
            "limits": { "$ref": "#/$defs/importLimits" }
          }
        }
      }
    },
    "importLimits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxFiles",
        "maxTotalBytes",
        "maxFileBytes",
        "maxPathBytes",
        "maxDepth"
      ],
      "properties": {
        "maxFiles": { "type": "integer", "minimum": 1 },
        "maxTotalBytes": { "type": "integer", "minimum": 1 },
        "maxFileBytes": { "type": "integer", "minimum": 1 },
        "maxPathBytes": { "type": "integer", "minimum": 1 },
        "maxDepth": { "type": "integer", "minimum": 1 }
      }
    },
    "createProjectRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "template"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/version" },
        "template": { "const": "blank" }
      }
    },
    "projectResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "project"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/version" },
        "project": { "$ref": "#/$defs/project" }
      }
    },
    "projectsResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "projects"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/version" },
        "projects": {
          "type": "array",
          "items": { "$ref": "#/$defs/project" }
        }
      }
    },
    "createImportPreviewRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/version" }
      }
    },
    "importPreviewFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "byteLength", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "byteLength": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "importPreviewExclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "reason"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "reason": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "importPreview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "displayName",
        "manifestSha256",
        "totalBytes",
        "entryPoint",
        "included",
        "excluded",
        "warnings"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "displayName": { "$ref": "#/$defs/nonEmptyString" },
        "manifestSha256": { "$ref": "#/$defs/sha256" },
        "totalBytes": { "type": "integer", "minimum": 0 },
        "entryPoint": {
          "anyOf": [{ "$ref": "#/$defs/relativePath" }, { "type": "null" }]
        },
        "included": {
          "type": "array",
          "items": { "$ref": "#/$defs/importPreviewFile" }
        },
        "excluded": {
          "type": "array",
          "items": { "$ref": "#/$defs/importPreviewExclusion" }
        },
        "warnings": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "importPreviewResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "importPreview"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/version" },
        "importPreview": { "$ref": "#/$defs/importPreview" }
      }
    },
    "confirmImportRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "expectedManifestSha256"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/version" },
        "expectedManifestSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "createTargetRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "target"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/version" },
        "target": { "$ref": "#/$defs/targetV1" }
      }
    },
    "targetResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "target", "resolution", "resolutionId"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/version" },
        "target": { "$ref": "#/$defs/targetV1" },
        "resolution": { "$ref": "#/$defs/targetResolverResultV1" },
        "resolutionId": { "$ref": "#/$defs/targetIdV1" }
      }
    },
    "targetSchemaVersion": { "const": 1 },
    "targetResolverVersion": { "const": 1 },
    "targetIdV1": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000]+$"
    },
    "targetPagePathV1": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?:/|(?!/)(?!.*[\\\\?#\\u0000])(?!(?:\\.|\\.\\.)(?:/|$))[^/]+(?:/(?!\\.\\.?(?:/|$))[^/]+)*)$"
    },
    "targetLabelV1": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000]+$"
    },
    "targetRectV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "number", "minimum": -1000000, "maximum": 1000000 },
        "y": { "type": "number", "minimum": -1000000, "maximum": 1000000 },
        "width": { "type": "number", "minimum": 0, "maximum": 1000000 },
        "height": { "type": "number", "minimum": 0, "maximum": 1000000 }
      }
    },
    "targetNonZeroRectV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "number", "minimum": -1000000, "maximum": 1000000 },
        "y": { "type": "number", "minimum": -1000000, "maximum": 1000000 },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000000
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000000
        }
      }
    },
    "targetNormalizedRectV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 },
        "width": { "type": "number", "minimum": 0, "maximum": 1 },
        "height": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "targetNonZeroNormalizedRectV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 },
        "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "height": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
      }
    },
    "targetGeometryV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "documentCssPixelRect",
        "viewportCssPixelRect",
        "viewportNormalizedRect"
      ],
      "properties": {
        "documentCssPixelRect": { "$ref": "#/$defs/targetRectV1" },
        "viewportCssPixelRect": { "$ref": "#/$defs/targetRectV1" },
        "viewportNormalizedRect": {
          "$ref": "#/$defs/targetNormalizedRectV1"
        }
      }
    },
    "targetRegionGeometryV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "documentCssPixelRect",
        "viewportCssPixelRect",
        "viewportNormalizedRect"
      ],
      "properties": {
        "documentCssPixelRect": { "$ref": "#/$defs/targetNonZeroRectV1" },
        "viewportCssPixelRect": { "$ref": "#/$defs/targetNonZeroRectV1" },
        "viewportNormalizedRect": {
          "$ref": "#/$defs/targetNonZeroNormalizedRectV1"
        }
      }
    },
    "targetPointCoordinatesV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1000000 },
        "y": { "type": "number", "minimum": 0, "maximum": 1000000 }
      }
    },
    "targetNormalizedPointV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "targetPointV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["documentCssPixel", "viewportNormalized"],
      "properties": {
        "documentCssPixel": { "$ref": "#/$defs/targetPointCoordinatesV1" },
        "viewportNormalized": { "$ref": "#/$defs/targetNormalizedPointV1" }
      }
    },
    "targetViewportV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cssWidth",
        "cssHeight",
        "scrollX",
        "scrollY",
        "devicePixelRatio",
        "visualViewportScale",
        "previewScale"
      ],
      "properties": {
        "cssWidth": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000000
        },
        "cssHeight": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000000
        },
        "scrollX": { "type": "number", "minimum": 0, "maximum": 1000000 },
        "scrollY": { "type": "number", "minimum": 0, "maximum": 1000000 },
        "devicePixelRatio": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 16
        },
        "visualViewportScale": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 16
        },
        "previewScale": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 8
        }
      }
    },
    "targetDocumentV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cssWidth", "cssHeight", "layoutEpoch"],
      "properties": {
        "cssWidth": { "type": "number", "minimum": 0, "maximum": 1000000 },
        "cssHeight": { "type": "number", "minimum": 0, "maximum": 1000000 },
        "layoutEpoch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "elementAnchorV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tagName"],
      "properties": {
        "tagName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z][A-Za-z0-9-]*$"
        },
        "uniqueElementId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "^[^\\u0000]+$"
        },
        "role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\u0000]+$"
        },
        "accessibleName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[^\\u0000]+$"
        },
        "domPath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "^[^\\u0000]+$"
        },
        "classTokens": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[^\\s\\u0000]+$"
          }
        },
        "ancestorFingerprint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "^[^\\u0000]+$"
        },
        "siblingIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        }
      }
    },
    "targetTextAnchorV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exact"],
      "dependentRequired": {
        "startOffset": ["endOffset"],
        "endOffset": ["startOffset"]
      },
      "properties": {
        "exact": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^[^\\u0000]+$"
        },
        "prefix": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000]+$"
        },
        "suffix": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000]+$"
        },
        "startOffset": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "endOffset": { "type": "integer", "minimum": 0, "maximum": 1000000 }
      }
    },
    "targetRegionAnchorV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layoutMode"],
      "properties": {
        "containingBlock": { "$ref": "#/$defs/elementAnchorV1" },
        "previousVisibleSibling": { "$ref": "#/$defs/elementAnchorV1" },
        "nextVisibleSibling": { "$ref": "#/$defs/elementAnchorV1" },
        "layoutMode": {
          "enum": ["flow", "flex", "grid", "positioned", "unknown"]
        }
      }
    },
    "targetPointRegionAnchorV1": {
      "allOf": [
        { "$ref": "#/$defs/targetRegionAnchorV1" },
        {
          "type": "object",
          "required": ["containingBlock"],
          "properties": { "containingBlock": true }
        }
      ]
    },
    "targetBlockV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "level"],
      "properties": {
        "source": { "enum": ["semantic", "landmark", "heuristic", "user"] },
        "level": { "type": "integer", "minimum": 0, "maximum": 64 }
      }
    },
    "targetCommonV1": {
      "type": "object",
      "required": [
        "schemaVersion",
        "targetId",
        "captureRevisionId",
        "captureSource",
        "pagePath",
        "kind",
        "label",
        "viewport",
        "document"
      ],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/targetSchemaVersion" },
        "targetId": { "$ref": "#/$defs/targetIdV1" },
        "captureRevisionId": { "$ref": "#/$defs/targetIdV1" },
        "captureSource": { "enum": ["accepted", "proposal"] },
        "pagePath": { "$ref": "#/$defs/targetPagePathV1" },
        "kind": {
          "enum": ["page", "block", "element", "text", "point", "region"]
        },
        "label": { "$ref": "#/$defs/targetLabelV1" },
        "viewport": { "$ref": "#/$defs/targetViewportV1" },
        "document": { "$ref": "#/$defs/targetDocumentV1" }
      }
    },
    "targetCaptureBindingV1": {
      "oneOf": [
        {
          "type": "object",
          "required": ["captureSource"],
          "properties": { "captureSource": { "const": "accepted" } },
          "not": {
            "required": ["captureProposalId"],
            "properties": { "captureProposalId": true }
          }
        },
        {
          "type": "object",
          "required": ["captureSource", "captureProposalId"],
          "properties": {
            "captureSource": { "const": "proposal" },
            "captureProposalId": { "$ref": "#/$defs/targetIdV1" }
          }
        }
      ]
    },
    "pageTargetV1": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/targetCommonV1" },
        { "$ref": "#/$defs/targetCaptureBindingV1" },
        {
          "type": "object",
          "required": ["kind"],
          "properties": { "kind": { "const": "page" } }
        }
      ],
      "unevaluatedProperties": false
    },
    "blockTargetV1": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/targetCommonV1" },
        { "$ref": "#/$defs/targetCaptureBindingV1" },
        {
          "type": "object",
          "required": ["kind", "elementAnchor", "block"],
          "properties": {
            "kind": { "const": "block" },
            "elementAnchor": { "$ref": "#/$defs/elementAnchorV1" },
            "block": { "$ref": "#/$defs/targetBlockV1" },
            "geometry": { "$ref": "#/$defs/targetGeometryV1" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "elementTargetV1": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/targetCommonV1" },
        { "$ref": "#/$defs/targetCaptureBindingV1" },
        {
          "type": "object",
          "required": ["kind", "elementAnchor"],
          "properties": {
            "kind": { "const": "element" },
            "elementAnchor": { "$ref": "#/$defs/elementAnchorV1" },
            "geometry": { "$ref": "#/$defs/targetGeometryV1" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "textTargetV1": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/targetCommonV1" },
        { "$ref": "#/$defs/targetCaptureBindingV1" },
        {
          "type": "object",
          "required": ["kind", "elementAnchor", "textAnchor"],
          "properties": {
            "kind": { "const": "text" },
            "elementAnchor": { "$ref": "#/$defs/elementAnchorV1" },
            "textAnchor": { "$ref": "#/$defs/targetTextAnchorV1" },
            "geometry": { "$ref": "#/$defs/targetGeometryV1" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "pointTargetV1": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/targetCommonV1" },
        { "$ref": "#/$defs/targetCaptureBindingV1" },
        {
          "type": "object",
          "required": ["kind", "point", "regionAnchor"],
          "properties": {
            "kind": { "const": "point" },
            "point": { "$ref": "#/$defs/targetPointV1" },
            "regionAnchor": { "$ref": "#/$defs/targetPointRegionAnchorV1" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "regionTargetV1": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/targetCommonV1" },
        { "$ref": "#/$defs/targetCaptureBindingV1" },
        {
          "type": "object",
          "required": ["kind", "geometry", "regionAnchor"],
          "properties": {
            "kind": { "const": "region" },
            "geometry": { "$ref": "#/$defs/targetRegionGeometryV1" },
            "regionAnchor": { "$ref": "#/$defs/targetRegionAnchorV1" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "targetV1": {
      "oneOf": [
        { "$ref": "#/$defs/pageTargetV1" },
        { "$ref": "#/$defs/blockTargetV1" },
        { "$ref": "#/$defs/elementTargetV1" },
        { "$ref": "#/$defs/textTargetV1" },
        { "$ref": "#/$defs/pointTargetV1" },
        { "$ref": "#/$defs/regionTargetV1" }
      ]
    },
    "targetResolverSignalV1": {
      "enum": [
        "unique_id",
        "semantic_fingerprint",
        "text_quote",
        "ancestor",
        "sibling",
        "dom_path",
        "geometry"
      ]
    },
    "targetResolverCandidateV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidateId", "score", "reasons", "summary"],
      "properties": {
        "candidateId": { "$ref": "#/$defs/targetIdV1" },
        "score": { "type": "number", "minimum": 0, "maximum": 1 },
        "reasons": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/targetResolverSignalV1" }
        },
        "summary": { "$ref": "#/$defs/targetLabelV1" },
        "elementAnchor": { "$ref": "#/$defs/elementAnchorV1" },
        "geometry": { "$ref": "#/$defs/targetGeometryV1" }
      }
    },
    "targetResolverResultV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "resolverVersion",
        "targetId",
        "captureRevisionId",
        "resolvedRevisionId",
        "status",
        "candidates"
      ],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/targetSchemaVersion" },
        "resolverVersion": { "$ref": "#/$defs/targetResolverVersion" },
        "targetId": { "$ref": "#/$defs/targetIdV1" },
        "captureRevisionId": { "$ref": "#/$defs/targetIdV1" },
        "resolvedRevisionId": { "$ref": "#/$defs/targetIdV1" },
        "status": { "enum": ["resolved", "ambiguous", "detached"] },
        "selectedCandidateId": { "$ref": "#/$defs/targetIdV1" },
        "candidates": {
          "type": "array",
          "maxItems": 8,
          "items": { "$ref": "#/$defs/targetResolverCandidateV1" }
        }
      },
      "oneOf": [
        {
          "type": "object",
          "required": ["status", "selectedCandidateId"],
          "properties": {
            "status": { "const": "resolved" },
            "selectedCandidateId": true,
            "candidates": { "type": "array", "minItems": 1 }
          }
        },
        {
          "type": "object",
          "required": ["status"],
          "properties": {
            "status": { "const": "ambiguous" },
            "candidates": { "type": "array", "minItems": 1 }
          },
          "not": {
            "required": ["selectedCandidateId"],
            "properties": { "selectedCandidateId": true }
          }
        },
        {
          "type": "object",
          "required": ["status"],
          "properties": { "status": { "const": "detached" } },
          "not": {
            "required": ["selectedCandidateId"],
            "properties": { "selectedCandidateId": true }
          }
        }
      ]
    },
    "createContextRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "revisionId",
        "targetId",
        "resolutionId",
        "instruction"
      ],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/version" },
        "revisionId": { "$ref": "#/$defs/nonEmptyString" },
        "targetId": { "$ref": "#/$defs/nonEmptyString" },
        "resolutionId": { "$ref": "#/$defs/targetIdV1" },
        "instruction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "x-maxUtf8Bytes": 2000
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revisionId",
        "targetId",
        "targetResolutionId",
        "instruction",
        "canonicalJson",
        "sha256"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "revisionId": { "$ref": "#/$defs/nonEmptyString" },
        "targetId": { "$ref": "#/$defs/nonEmptyString" },
        "targetResolutionId": { "$ref": "#/$defs/targetIdV1" },
        "instruction": { "type": "string" },
        "canonicalJson": { "type": "string" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "contextResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "context"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/version" },
        "context": { "$ref": "#/$defs/context" }
      }
    },
    "createProposalRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "contextId", "contextSha256"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/version" },
        "contextId": { "$ref": "#/$defs/nonEmptyString" },
        "contextSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "validationCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "status", "message"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "label": { "$ref": "#/$defs/nonEmptyString" },
        "status": { "enum": ["passed", "warning", "failed"] },
        "message": { "type": "string" }
      }
    },
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "reviewId",
        "baseRevisionId",
        "status",
        "summary",
        "artifactManifestSha256",
        "reviewContextSha256",
        "sourceAttribution",
        "executionVerified",
        "previewUrl",
        "changes",
        "unifiedDiff",
        "validation"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "reviewId": { "$ref": "#/$defs/nonEmptyString" },
        "baseRevisionId": { "$ref": "#/$defs/nonEmptyString" },
        "status": { "const": "pending_review" },
        "summary": { "type": "string" },
        "artifactManifestSha256": { "$ref": "#/$defs/sha256" },
        "reviewContextSha256": { "$ref": "#/$defs/sha256" },
        "sourceAttribution": { "const": "caller_supplied_ai_attributed" },
        "executionVerified": { "const": false },
        "previewUrl": { "$ref": "#/$defs/scopedPreviewUrl" },
        "changes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "kind"],
            "properties": {
              "path": { "$ref": "#/$defs/nonEmptyString" },
              "kind": {
                "enum": ["created", "modified", "renamed", "deleted"]
              }
            }
          }
        },
        "unifiedDiff": { "type": "string" },
        "validation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "checks"],
          "properties": {
            "status": { "enum": ["passed", "warning", "failed"] },
            "checks": {
              "type": "array",
              "items": { "$ref": "#/$defs/validationCheck" }
            }
          }
        }
      }
    },
    "proposalResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "proposal"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/version" },
        "proposal": { "$ref": "#/$defs/proposal" }
      }
    },
    "approvalRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "proposalId",
        "expectedRevisionId",
        "disposition",
        "intentId"
      ],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/version" },
        "proposalId": { "$ref": "#/$defs/nonEmptyString" },
        "expectedRevisionId": { "$ref": "#/$defs/nonEmptyString" },
        "disposition": { "$ref": "#/$defs/disposition" },
        "intentId": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "approvalResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "approval"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/version" },
        "approval": {
          "type": "object",
          "additionalProperties": false,
          "required": ["token", "expiresAt", "intentId"],
          "properties": {
            "token": { "$ref": "#/$defs/nonEmptyString" },
            "expiresAt": { "$ref": "#/$defs/nonEmptyString" },
            "intentId": { "$ref": "#/$defs/nonEmptyString" }
          }
        }
      }
    },
    "decisionRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "approvalToken",
        "proposalId",
        "expectedRevisionId",
        "disposition",
        "intentId"
      ],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/version" },
        "approvalToken": { "$ref": "#/$defs/nonEmptyString" },
        "proposalId": { "$ref": "#/$defs/nonEmptyString" },
        "expectedRevisionId": { "$ref": "#/$defs/nonEmptyString" },
        "disposition": { "$ref": "#/$defs/disposition" },
        "intentId": { "$ref": "#/$defs/nonEmptyString" },
        "rationale": {
          "type": "string",
          "maxLength": 2000,
          "x-maxUtf8Bytes": 2000
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewId",
        "proposalId",
        "disposition",
        "status",
        "revisionId",
        "artifactManifestSha256"
      ],
      "properties": {
        "reviewId": { "$ref": "#/$defs/nonEmptyString" },
        "proposalId": { "$ref": "#/$defs/nonEmptyString" },
        "disposition": { "$ref": "#/$defs/disposition" },
        "status": { "const": "committed" },
        "revisionId": { "$ref": "#/$defs/nonEmptyString" },
        "artifactManifestSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "decisionResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "decision", "project"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/version" },
        "decision": { "$ref": "#/$defs/decision" },
        "project": { "$ref": "#/$defs/project" }
      }
    },
    "createExportRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "revisionId"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/version" },
        "revisionId": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "exportReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revisionId", "sha256", "byteLength", "downloadUrl"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "revisionId": { "$ref": "#/$defs/nonEmptyString" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "byteLength": { "type": "integer", "minimum": 0 },
        "downloadUrl": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "exportResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "export"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/version" },
        "export": { "$ref": "#/$defs/exportReceipt" }
      }
    },
    "errorResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "error"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/version" },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message", "requestId", "retryable"],
          "properties": {
            "code": { "$ref": "#/$defs/nonEmptyString" },
            "message": { "$ref": "#/$defs/nonEmptyString" },
            "requestId": { "$ref": "#/$defs/nonEmptyString" },
            "retryable": { "type": "boolean" }
          }
        }
      }
    },
    "rect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "width": { "type": "number", "minimum": 0 },
        "height": { "type": "number", "minimum": 0 }
      }
    },
    "previewSelectionMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "schemaVersion",
        "channelId",
        "projectId",
        "snapshotId",
        "revisionId",
        "elementId",
        "rect"
      ],
      "properties": {
        "type": { "const": "synapsegit-lp.selection" },
        "schemaVersion": { "$ref": "#/$defs/version" },
        "channelId": { "$ref": "#/$defs/nonEmptyString" },
        "projectId": { "$ref": "#/$defs/nonEmptyString" },
        "snapshotId": { "$ref": "#/$defs/nonEmptyString" },
        "revisionId": { "$ref": "#/$defs/nonEmptyString" },
        "elementId": { "$ref": "#/$defs/nonEmptyString" },
        "rect": { "$ref": "#/$defs/rect" }
      }
    },
    "previewDiagnosticMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "schemaVersion",
        "channelId",
        "projectId",
        "snapshotId",
        "revisionId",
        "severity",
        "code",
        "sourceUnavailable"
      ],
      "properties": {
        "type": { "const": "synapsegit-lp.diagnostic" },
        "schemaVersion": { "$ref": "#/$defs/version" },
        "channelId": { "$ref": "#/$defs/nonEmptyString" },
        "projectId": { "$ref": "#/$defs/nonEmptyString" },
        "snapshotId": { "$ref": "#/$defs/nonEmptyString" },
        "revisionId": { "$ref": "#/$defs/nonEmptyString" },
        "severity": { "enum": ["warning", "error"] },
        "code": {
          "enum": ["csp_blocked", "site_error", "unhandled_rejection"]
        },
        "sourceUnavailable": { "const": true }
      }
    },
    "previewTargetMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "schemaVersion",
        "channelId",
        "projectId",
        "snapshotId",
        "revisionId",
        "target"
      ],
      "properties": {
        "type": { "const": "synapsegit-lp.target-draft" },
        "schemaVersion": { "$ref": "#/$defs/version" },
        "channelId": { "$ref": "#/$defs/nonEmptyString" },
        "projectId": { "$ref": "#/$defs/nonEmptyString" },
        "snapshotId": { "$ref": "#/$defs/nonEmptyString" },
        "revisionId": { "$ref": "#/$defs/nonEmptyString" },
        "target": { "$ref": "#/$defs/targetV1" }
      }
    },
    "previewStructureNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtimeNodeHandle", "kind", "label", "tagName", "depth"],
      "properties": {
        "runtimeNodeHandle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "parentRuntimeNodeHandle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "kind": { "enum": ["block", "element"] },
        "label": { "$ref": "#/$defs/targetLabelV1" },
        "tagName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "depth": { "type": "integer", "minimum": 0, "maximum": 64 }
      }
    },
    "previewStructureMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "schemaVersion",
        "channelId",
        "projectId",
        "snapshotId",
        "revisionId",
        "nodes"
      ],
      "properties": {
        "type": { "const": "synapsegit-lp.structure" },
        "schemaVersion": { "$ref": "#/$defs/version" },
        "channelId": { "$ref": "#/$defs/nonEmptyString" },
        "projectId": { "$ref": "#/$defs/nonEmptyString" },
        "snapshotId": { "$ref": "#/$defs/nonEmptyString" },
        "revisionId": { "$ref": "#/$defs/nonEmptyString" },
        "nodes": {
          "type": "array",
          "maxItems": 200,
          "items": { "$ref": "#/$defs/previewStructureNode" }
        }
      }
    },
    "previewActionMessage": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "schemaVersion",
            "channelId",
            "action",
            "mode",
            "targetKind",
            "previewScale",
            "projectId",
            "snapshotId",
            "revisionId"
          ],
          "properties": {
            "type": { "const": "synapsegit-lp.action" },
            "schemaVersion": { "$ref": "#/$defs/version" },
            "channelId": { "$ref": "#/$defs/nonEmptyString" },
            "action": { "const": "set_mode" },
            "mode": { "enum": ["select", "interact"] },
            "targetKind": {
              "enum": ["page", "block", "element", "text", "point", "region"]
            },
            "previewScale": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 8
            },
            "projectId": { "$ref": "#/$defs/nonEmptyString" },
            "snapshotId": { "$ref": "#/$defs/nonEmptyString" },
            "revisionId": { "$ref": "#/$defs/nonEmptyString" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "schemaVersion",
            "channelId",
            "action",
            "projectId",
            "snapshotId",
            "revisionId"
          ],
          "properties": {
            "type": { "const": "synapsegit-lp.action" },
            "schemaVersion": { "$ref": "#/$defs/version" },
            "channelId": { "$ref": "#/$defs/nonEmptyString" },
            "action": {
              "enum": ["clear_selection", "request_structure", "capture_page"]
            },
            "projectId": { "$ref": "#/$defs/nonEmptyString" },
            "snapshotId": { "$ref": "#/$defs/nonEmptyString" },
            "revisionId": { "$ref": "#/$defs/nonEmptyString" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "schemaVersion",
            "channelId",
            "action",
            "runtimeNodeHandle",
            "targetKind",
            "projectId",
            "snapshotId",
            "revisionId"
          ],
          "properties": {
            "type": { "const": "synapsegit-lp.action" },
            "schemaVersion": { "$ref": "#/$defs/version" },
            "channelId": { "$ref": "#/$defs/nonEmptyString" },
            "action": { "const": "capture_node" },
            "runtimeNodeHandle": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "targetKind": {
              "enum": ["page", "block", "element", "text", "point", "region"]
            },
            "projectId": { "$ref": "#/$defs/nonEmptyString" },
            "snapshotId": { "$ref": "#/$defs/nonEmptyString" },
            "revisionId": { "$ref": "#/$defs/nonEmptyString" }
          }
        }
      ]
    }
  }
}
